{
  "name": "graft",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx scripts/setup-env.ts",
    "postinstall": "tsx scripts/setup-env.ts --quiet",
    "dev": "dotenv -e .env.dev -- next dev",
    "dev:db": "docker compose --env-file .env.dev -f docker/docker-compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose --env-file .env.dev -f docker/docker-compose.dev.yml down",
    "dev:db:nuke": "docker compose --env-file .env.dev -f docker/docker-compose.dev.yml down -v",
    "dev:seed": "dotenv -e .env.dev -- tsx scripts/wait-for-mongo.ts && dotenv -e .env.dev -- tsx scripts/create-indexes.ts && dotenv -e .env.dev -- tsx scripts/seed-dev.ts",
    "dev:reset": "dotenv -e .env.dev -- tsx scripts/reset-db.ts && npm run dev:seed",
    "dev:full": "npm run dev:db && npm run dev:seed && npm run dev",
    "qa:db": "docker compose --env-file .env.qa -f docker/docker-compose.qa.yml up -d --wait",
    "qa:db:down": "docker compose --env-file .env.qa -f docker/docker-compose.qa.yml down -v",
    "qa:seed": "dotenv -e .env.qa -- tsx scripts/wait-for-mongo.ts && dotenv -e .env.qa -- tsx scripts/create-indexes.ts && dotenv -e .env.qa -- tsx scripts/seed-qa.ts",
    "qa:build": "dotenv -e .env.qa -- next build",
    "qa:app": "npm run qa:build && dotenv -e .env.qa -- next start -p 3100",
    "qa:full": "npm run qa:db && npm run qa:seed && npm run qa:app",
    "lint": "next lint && prettier --check .",
    "lint:fix": "next lint --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:api": "cd bruno && bru run --env ci -r",
    "test:api:local": "cd bruno && bru run --env local -r",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:integration",
    "verify:full": "npm run verify && npm run qa:db && npm run qa:seed && npm run qa:build && dotenv -e .env.qa -- tsx scripts/with-qa-app.ts npm run test:api && npm run qa:db:down",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "build": "next build",
    "start": "next start",
    "release:check": "npm run verify:full && npm audit --audit-level=high"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "mongodb": "^6.12.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@faker-js/faker": "^9.4.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@usebruno/cli": "^1.38.1",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
