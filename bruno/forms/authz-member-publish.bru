meta {
  name: A member can neither publish nor unpublish a form
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/api/v1/forms/000000000000000000000026/unpublish
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{premiumMemberAccessToken}}
}

script:pre-request {
  // The publish attempt is made here and carried across in vars, so both
  // halves are asserted synchronously (an async `test()` body would not count
  // towards the gate).
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  // Logged in once and reused by every member file: the `auth` scope allows
  // 5 logins per email per 15 minutes (src/server/rate-limit/scopes.ts).
  if (!bru.getVar("premiumMemberAccessToken")) {
    const login = await axios.post(`${baseUrl}/api/v1/auth/login`, {
      email: "member@qa-premium.test",
      password: bru.getEnvVar("qaPassword"),
    });
    bru.setVar("premiumMemberAccessToken", login.data.data.accessToken);
  }
  const token = bru.getVar("premiumMemberAccessToken");

  const publish = await axios.post(
    `${baseUrl}/api/v1/forms/000000000000000000000026/publish`,
    null,
    { headers: { Authorization: `Bearer ${token}` }, validateStatus: () => true },
  );
  bru.setVar("memberPublishStatus", publish.status);
  bru.setVar("memberPublishCode", publish.data?.error?.code);
  bru.setVar("memberPublishHasRequestId", Boolean(publish.data?.error?.requestId));
}

assert {
  res.status: eq 403
  res.body.error.code: eq FORBIDDEN
  res.body.error.message: eq "Only an owner or admin can change forms"
  res.body.error.requestId: isDefined
  res.body.data: isUndefined
}

script:post-response {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const read = await axios.get(`${baseUrl}/api/v1/forms/000000000000000000000026`, {
    headers: { Authorization: `Bearer ${bru.getVar("premiumMemberAccessToken")}` },
  });
  bru.setVar("memberPublishReadPublished", read.data.data.published);
  bru.setVar("memberPublishReadSlug", read.data.data.publicSlug);
}

tests {
  test("AC1 — the member's publish is 403 FORBIDDEN in the standard envelope", function () {
    expect(String(bru.getVar("memberPublishStatus"))).to.equal("403");
    expect(String(bru.getVar("memberPublishCode"))).to.equal("FORBIDDEN");
    expect(String(bru.getVar("memberPublishHasRequestId"))).to.equal("true");
  });

  test("AC1 — the refused unpublish left the form published at its public URL", function () {
    expect(String(bru.getVar("memberPublishReadPublished"))).to.equal("true");
    expect(String(bru.getVar("memberPublishReadSlug"))).to.equal(
      "qa-premium/qa-premium-payment-form",
    );
  });
}

docs {
  GRAFT-31 AC1 (publish and unpublish). Runs against formPremiumPayment
  (000000000000000000000026, scripts/seed-qa.ts), which is seeded published.
  The role check runs before the form is even looked up, so publish is
  refused with 403 rather than short-circuiting as "already published".
}
