meta {
  name: Manual payment shows the tenant's instructions and redirects nobody
  type: http
  seq: 38
}

patch {
  url: {{baseUrl}}/api/v1/forms/000000000000000000000026
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{premiumAccessToken}}
}

body:json {
  {
    "payment": {
      "mode": "manual",
      "instructions": "  Pay by bank transfer within 7 days.  ",
      "required": true,
      "link": { "url": "https://buy.stripe.com/should-be-dropped" }
    }
  }
}

script:pre-request {
  // Premium tenant, for the api rate-limit reason in payment-link-config.bru.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const login = await axios.post(`${baseUrl}/api/v1/auth/login`, {
    email: "owner@qa-premium.test",
    password: bru.getEnvVar("qaPassword"),
  });
  bru.setVar("premiumAccessToken", login.data.data.accessToken);
}

script:post-response {
  // The follow-up calls are made here and their answers kept in vars: a
  // `test()` body that awaits never fails the run, so every check below is
  // synchronous against what this script stored.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const auth = { headers: { Authorization: `Bearer ${bru.getVar("premiumAccessToken")}` } };
  const formUrl = `${baseUrl}/api/v1/forms/000000000000000000000026`;

  const read = await axios.get(formUrl, auth);
  bru.setVar("manualReadBack", JSON.stringify(read.data.data.payment));

  const submit = await axios.post(
    `${baseUrl}/api/v1/public/forms/qa-premium/qa-premium-payment-form/submissions`,
    {
      data: {
        name: `QA Manual Payment ${Date.now()}`,
        email: "manual-payment@qa.test",
        phone: "+353 1 000 0097",
      },
      // Comfortably past MIN_FILL_MS (public-forms.ts) so this isn't spam.
      _t: Date.now() - 3000,
    },
    { validateStatus: () => true },
  );
  bru.setVar("manualSubmitStatus", submit.status);
  bru.setVar("manualSubmitBody", JSON.stringify(submit.data));

  // Leave the fixture as seeded (payment off) for the next run and for
  // payment-link-rejects-bad-url.bru.
  const off = await axios.patch(formUrl, { payment: null }, auth);
  bru.setVar("manualCleanup", JSON.stringify(off.data.data.payment));
}

assert {
  res.status: eq 200
  res.body.data.payment.mode: eq manual
  res.body.data.payment.instructions: eq Pay by bank transfer within 7 days.
  res.body.data.payment.required: isUndefined
  res.body.data.payment.link: isUndefined
  res.body.error: isUndefined
}

tests {
  const readBack = JSON.parse(bru.getVar("manualReadBack"));
  const submitBody = JSON.parse(bru.getVar("manualSubmitBody"));

  test("it reads back on the next GET, trimmed, with no redirect fields", function () {
    expect(readBack).to.deep.equal({
      mode: "manual",
      instructions: "Pay by bank transfer within 7 days.",
    });
  });

  test("a public submission is accepted and carries the instructions", function () {
    expect(bru.getVar("manualSubmitStatus")).to.equal(201);
    expect(submitBody.data.submissionId).to.match(/^[0-9a-f]{24}$/);
    expect(submitBody.data.paymentInstructions).to.equal("Pay by bank transfer within 7 days.");
  });

  test("the submission response has no payment block — nobody is sent to Stripe", function () {
    expect(submitBody.data).to.not.have.property("payment");
  });

  test("payment is off again afterwards", function () {
    expect(bru.getVar("manualCleanup")).to.equal("null");
  });
}

docs {
  Manual payment mode (adhoc/payment-options). Runs against formPremiumPayment
  (000000000000000000000026, scripts/seed-qa.ts), seeded with payment off, and
  ends with payment off again. The stray `required` and `link` in the body
  prove manual mode stores no redirect of any kind.
}
