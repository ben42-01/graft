meta {
  name: Payment links can be set on a form and turned off again
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/forms/000000000000000000000026
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{premiumAccessToken}}
}

body:json {
  {
    "payment": {
      "mode": "link",
      "link": { "url": "https://buy.stripe.com/qa-config-check?prefilled_email=x" },
      "required": true
    }
  }
}

script:pre-request {
  // Logged in as the *premium* tenant's owner rather than reusing
  // `loginAccessToken` (the free tenant): the `api` rate-limit scope is keyed
  // by tenant (src/server/rate-limit/scopes.ts) and free is 60/min, which the
  // rest of this suite already shares. This file and its sibling
  // payment-link-rejects-bad-url.bru spend the premium tenant's 600 instead.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const login = await axios.post(`${baseUrl}/api/v1/auth/login`, {
    email: "owner@qa-premium.test",
    password: bru.getEnvVar("qaPassword"),
  });
  bru.setVar("premiumAccessToken", login.data.data.accessToken);
}

assert {
  res.status: eq 200
  res.body.data.payment.mode: eq link
  res.body.data.payment.required: eq true
  res.body.error: isUndefined
}

tests {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const auth = { headers: { Authorization: `Bearer ${bru.getVar("premiumAccessToken")}` } };
  const formUrl = `${baseUrl}/api/v1/forms/000000000000000000000026`;

  test("AC1 — the pasted URL is stored verbatim", function () {
    expect(res.getBody().data.payment.link.url).to.equal(
      "https://buy.stripe.com/qa-config-check?prefilled_email=x",
    );
  });

  test("AC1 — it reads back on the next GET", async function () {
    const read = await axios.get(formUrl, auth);
    expect(read.data.data.payment.link.url).to.equal(
      "https://buy.stripe.com/qa-config-check?prefilled_email=x",
    );
    expect(read.data.data.payment.required).to.equal(true);
  });

  test("AC1, AC11 — an explicit null turns payment off again", async function () {
    const off = await axios.patch(formUrl, { payment: null }, auth);
    expect(off.data.data.payment).to.equal(null);
  });
}

docs {
  GRAFT-24 AC1, AC11. Runs against formPremiumPayment
  (000000000000000000000026, scripts/seed-qa.ts), a published form of the
  premium tenant seeded with payment off. It ends with payment off again, so
  the fixture is in the same state for the next run and for
  payment-link-rejects-bad-url.bru, which asserts nothing hostile was stored.
}
