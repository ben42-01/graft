meta {
  name: Publishing assigns a globally-unique publicSlug and reserves quota
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/forms/{{createdFormId}}/publish
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{freeOwnerAccessToken}}
}

script:pre-request {
  // GRAFT-31 — form writes (and enabling a plugin that provisions forms) are
  // owner/admin only. `loginAccessToken` is both@qa.test, a *member* of the
  // free tenant, so this file writes as the free tenant's owner instead.
  // Logged in once and reused across files: the `auth` scope allows 5 logins
  // per email per 15 minutes (src/server/rate-limit/scopes.ts).
  if (!bru.getVar("freeOwnerAccessToken")) {
    const axios = require("axios");
    const login = await axios.post(`${bru.getEnvVar("baseUrl")}/api/v1/auth/login`, {
      email: "owner@qa-free.test",
      password: bru.getEnvVar("qaPassword"),
    });
    bru.setVar("freeOwnerAccessToken", login.data.data.accessToken);
  }
}

assert {
  res.status: eq 200
  res.body.data.published: eq true
  res.body.data.publicSlug: eq qa-free/qa-booking-request
  res.body.error: isUndefined
}

tests {
  test("AC2 — publicSlug is {tenantSlug}/{formSlug}", function () {
    expect(res.getBody().data.publicSlug).to.equal("qa-free/qa-booking-request");
  });
}

docs {
  AC2. Depends on create.bru having run first (createdFormId). The AC4 hard
  stop (a refused publish leaves the form untouched) is proven directly
  against the service in src/server/services/forms.test.ts, which does not
  need a running QA stack to prove it.
}
