meta {
  name: An SVG is refused — it is a script host, not a photo
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/forms/{{createdFormId}}/media
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{freeOwnerAccessToken}}
}

script:pre-request {
  // GRAFT-31 — form writes (and enabling a plugin that provisions forms) are
  // owner/admin only. `loginAccessToken` is both@qa.test, a *member* of the
  // free tenant, so this file writes as the free tenant's owner instead.
  // Logged in once and reused across files: the `auth` scope allows 5 logins
  // per email per 15 minutes (src/server/rate-limit/scopes.ts).
  if (!bru.getVar("freeOwnerAccessToken")) {
    const axios = require("axios");
    const login = await axios.post(`${bru.getEnvVar("baseUrl")}/api/v1/auth/login`, {
      email: "owner@qa-free.test",
      password: bru.getEnvVar("qaPassword"),
    });
    bru.setVar("freeOwnerAccessToken", login.data.data.accessToken);
  }
}

body:json {
  {
    "contentType": "image/svg+xml",
    "sizeBytes": 2048
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_FAILED
  res.body.error.requestId: isDefined
  res.body.data: isUndefined
}

tests {
  test("the content type allow-list is an allow-list", function () {
    // These objects are served to anonymous visitors on a public form page; an
    // SVG there is stored XSS with extra steps. Raster formats only.
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  src/server/services/media.ts ALLOWED_IMAGE_TYPES. The same schema also caps
  the declared size, proven in src/server/services/media.test.ts.
}
