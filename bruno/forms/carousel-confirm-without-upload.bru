meta {
  name: Confirming an upload that never landed is refused
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/forms/{{createdFormId}}/media/{{carouselMediaId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{freeOwnerAccessToken}}
}

script:pre-request {
  // GRAFT-31 — form writes (and enabling a plugin that provisions forms) are
  // owner/admin only. `loginAccessToken` is both@qa.test, a *member* of the
  // free tenant, so this file writes as the free tenant's owner instead.
  // Logged in once and reused across files: the `auth` scope allows 5 logins
  // per email per 15 minutes (src/server/rate-limit/scopes.ts).
  if (!bru.getVar("freeOwnerAccessToken")) {
    const axios = require("axios");
    const login = await axios.post(`${bru.getEnvVar("baseUrl")}/api/v1/auth/login`, {
      email: "owner@qa-free.test",
      password: bru.getEnvVar("qaPassword"),
    });
    bru.setVar("freeOwnerAccessToken", login.data.data.accessToken);
  }
}

body:json {
  {
    "alt": "A product photo that was never uploaded"
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_FAILED
  res.body.data: isUndefined
}

tests {
  test("the bucket, not the client, decides whether an object exists", function () {
    // carousel-upload-ticket.bru minted a URL but never PUT anything to it, so
    // the HEAD in confirmUpload finds nothing and the slide is not created.
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  The half of the two-step upload that catches an abandoned or forged confirm.
  A successful end-to-end upload needs a real binary PUT to the presigned URL,
  which is a Playwright concern (e2e/), not a Bruno one.
}
