meta {
  name: Only an https buy.stripe.com link is accepted as a payment link
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/v1/forms/000000000000000000000026
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{premiumAccessToken}}
}

body:json {
  {
    "payment": {
      "mode": "link",
      "link": { "url": "https://buy.stripe.com.evil.test/x" },
      "required": true
    }
  }
}

script:pre-request {
  // AC2 and the rest of AC3's table are probed *here*, before the request, so
  // that the `tests` block below can assert them synchronously. Bruno's CLI
  // runs an `async test()` body without folding its result into the run's
  // pass/fail totals, so an async assertion is documentation rather than a
  // gate; a pre-request script, by contrast, is awaited by the runner. The
  // file's own request (the suffix attack) stays in the sync `assert` block.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const auth = {
    headers: { Authorization: `Bearer ${bru.getVar("premiumAccessToken")}` },
    validateStatus: () => true,
  };
  const formUrl = `${baseUrl}/api/v1/forms/000000000000000000000026`;
  const patch = (body) => axios.patch(formUrl, body, auth);
  const link = (url) => ({ payment: { mode: "link", link: { url }, required: true } });

  // The rest of AC3's table — the file's own request is the eighth case. The
  // host is compared against the *parsed* URL's host, so none of these can
  // pass by containing the allowed host somewhere in the string.
  const hostile = [
    "http://buy.stripe.com/x",
    "https://evil.test/x",
    "https://evil.test/?x=buy.stripe.com",
    "javascript:alert(1)",
    "//buy.stripe.com/x",
    "",
  ];

  const outcomes = {};
  for (const url of hostile) {
    const response = await patch(link(url));
    outcomes[url] = { status: response.status, code: response.data?.error?.code };
  }

  // AC2 — keys mode does not exist yet and is refused the same way.
  const keys = await patch({
    payment: { mode: "keys", link: { url: "https://buy.stripe.com/abc" }, required: true },
  });
  outcomes["mode:keys"] = { status: keys.status, code: keys.data?.error?.code };

  // AC3 — and none of those refusals stored anything.
  const read = await axios.get(formUrl, auth);
  outcomes["stored"] = read.data?.data?.payment ?? null;

  bru.setVar("hostileOutcomes", JSON.stringify(outcomes));
  bru.setVar("hostileUrls", JSON.stringify(hostile));
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_FAILED
  res.body.error.requestId: isDefined
  res.body.data: isUndefined
}

tests {
  // Every assertion below is synchronous, so each one counts towards the run's
  // pass/fail totals. The HTTP work behind them happened in script:pre-request.
  const outcomes = JSON.parse(bru.getVar("hostileOutcomes"));
  const hostile = JSON.parse(bru.getVar("hostileUrls"));
  const refused = (key) => {
    expect(outcomes[key].status, key).to.equal(400);
    expect(outcomes[key].code, key).to.equal("VALIDATION_FAILED");
  };

  test("AC3 — http://buy.stripe.com/x is refused: the protocol is wrong", function () {
    refused("http://buy.stripe.com/x");
  });

  test("AC3 — https://evil.test/x is refused: the host is not on the allow-list", function () {
    refused("https://evil.test/x");
  });

  test("AC3 — https://evil.test/?x=buy.stripe.com is refused: the host is parsed, not searched", function () {
    refused("https://evil.test/?x=buy.stripe.com");
  });

  test("AC3 — javascript:alert(1) is refused", function () {
    refused("javascript:alert(1)");
  });

  test("AC3 — //buy.stripe.com/x is refused: no base URL, so it never gains a scheme", function () {
    refused("//buy.stripe.com/x");
  });

  test("AC3 — the empty string is refused", function () {
    refused("");
  });

  test("AC3 — the whole hostile table was exercised, not a subset", function () {
    // Guards the loop above against silently probing nothing.
    expect(hostile).to.have.lengthOf(6);
    for (const url of hostile) expect(outcomes).to.have.property(url);
  });

  test("AC2 — keys mode does not exist yet and is refused the same way", function () {
    refused("mode:keys");
  });

  test("AC3 — nothing hostile was stored by any of the refused attempts", function () {
    expect(outcomes.stored).to.equal(null);
  });
}

docs {
  GRAFT-24 AC2, AC3. Open redirect is the whole risk of link mode: Graft sends
  an unauthenticated visitor to a URL a tenant typed, so the allow-list is on
  the parsed URL's protocol and host, never a substring test. Reuses
  `premiumAccessToken` from payment-link-config.bru (seq 16), which explains
  why these run against the premium tenant. The hostile table and the keys-mode
  probe are issued from script:pre-request so that every assertion in `tests`
  is synchronous and therefore counted by the runner. The same table runs as
  pure unit coverage in src/server/services/forms.test.ts.
}
