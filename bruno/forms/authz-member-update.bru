meta {
  name: A member cannot change a form, and the form reads back unchanged
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/api/v1/forms/000000000000000000000026
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{premiumMemberAccessToken}}
}

script:pre-request {
  // The refused PATCH happens here so that the request this file asserts on
  // synchronously is the read-back (GET): an async `test()` body would not
  // count towards the gate. The PATCH's outcome is carried across in vars and
  // asserted in synchronous tests below.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  // Logged in once and reused by every member file: the `auth` scope allows
  // 5 logins per email per 15 minutes (src/server/rate-limit/scopes.ts).
  if (!bru.getVar("premiumMemberAccessToken")) {
    const login = await axios.post(`${baseUrl}/api/v1/auth/login`, {
      email: "member@qa-premium.test",
      password: bru.getEnvVar("qaPassword"),
    });
    bru.setVar("premiumMemberAccessToken", login.data.data.accessToken);
  }
  const token = bru.getVar("premiumMemberAccessToken");

  const patch = await axios.patch(
    `${baseUrl}/api/v1/forms/000000000000000000000026`,
    { name: "Renamed by a member", enabled: false },
    { headers: { Authorization: `Bearer ${token}` }, validateStatus: () => true },
  );
  bru.setVar("memberPatchStatus", patch.status);
  bru.setVar("memberPatchCode", patch.data?.error?.code);
  bru.setVar("memberPatchHasRequestId", Boolean(patch.data?.error?.requestId));
  bru.setVar("memberPatchHasData", patch.data?.data !== undefined);
}

assert {
  res.status: eq 200
  res.body.data.id: eq "000000000000000000000026"
  res.body.data.name: eq "QA Premium Payment Form"
  res.body.data.enabled: eq true
  res.body.data.published: eq true
  res.body.error: isUndefined
}

tests {
  test("AC1 — the member's PATCH is 403 FORBIDDEN in the standard envelope", function () {
    expect(String(bru.getVar("memberPatchStatus"))).to.equal("403");
    expect(String(bru.getVar("memberPatchCode"))).to.equal("FORBIDDEN");
    expect(String(bru.getVar("memberPatchHasRequestId"))).to.equal("true");
    expect(String(bru.getVar("memberPatchHasData"))).to.equal("false");
  });
}

docs {
  GRAFT-31 AC1 (PATCH). Runs against formPremiumPayment
  (000000000000000000000026, scripts/seed-qa.ts). The PATCH tries to rename
  the form and hit its kill switch; the GET shows the seeded name and
  `enabled: true`, so nothing was written. payment-link-config.bru changes
  only this form's `payment`, which this file does not read.
}
