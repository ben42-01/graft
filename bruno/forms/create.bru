meta {
  name: Creating a form binds it to an entity with a real field subset
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/forms
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{freeOwnerAccessToken}}
}

script:pre-request {
  // GRAFT-31 — form writes (and enabling a plugin that provisions forms) are
  // owner/admin only. `loginAccessToken` is both@qa.test, a *member* of the
  // free tenant, so this file writes as the free tenant's owner instead.
  // Logged in once and reused across files: the `auth` scope allows 5 logins
  // per email per 15 minutes (src/server/rate-limit/scopes.ts).
  if (!bru.getVar("freeOwnerAccessToken")) {
    const axios = require("axios");
    const login = await axios.post(`${bru.getEnvVar("baseUrl")}/api/v1/auth/login`, {
      email: "owner@qa-free.test",
      password: bru.getEnvVar("qaPassword"),
    });
    bru.setVar("freeOwnerAccessToken", login.data.data.accessToken);
  }
}

body:json {
  {
    "entityId": "000000000000000000000015",
    "name": "QA Booking Request",
    "slug": "qa-booking-request",
    "visibility": "public",
    "fields": [{ "key": "name" }, { "key": "email" }]
  }
}

assert {
  res.status: eq 201
  res.body.data.published: eq false
  res.body.data.publicSlug: isNull
  res.body.data.enabled: eq true
  res.body.error: isUndefined
}

script:post-response {
  // Carried into publish.bru and unpublish.bru — created against the free
  // tenant's "customers" entity (000000000000000000000015, scripts/seed-qa.ts).
  bru.setVar("createdFormId", res.body.data.id);
}

tests {
  const form = res.getBody().data;

  test("AC1 — the field list is the requested subset of the entity's fields", function () {
    expect(form.fields.map((f) => f.key).sort()).to.eql(["email", "name"]);
  });

  test("a new form starts internal to the tenant and unpublished", function () {
    expect(form.visibility).to.equal("public");
    expect(form.published).to.equal(false);
  });

  test("the id is a real Mongo ObjectId hex", function () {
    expect(form.id).to.match(/^[0-9a-f]{24}$/);
  });
}

docs {
  AC1. Written as owner@qa-free.test (GRAFT-31: a member may not create
  forms); the token is logged in by this file's pre-request script. Rejection of a field the entity does not have is proven
  directly against `resolveFormFields` in src/server/services/forms.test.ts,
  which does not need a running QA stack to prove it.
}
