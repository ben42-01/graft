meta {
  name: A member cannot create a form, and the refusal costs no quota
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/v1/forms
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{memberFormsToken}}
}

body:json {
  {
    "entityId": "000000000000000000000016",
    "name": "QA Member's Form",
    "slug": "qa-member-authz-create",
    "visibility": "internal",
    "fields": [{ "key": "name" }]
  }
}

script:pre-request {
  // member@qa-premium.test (scripts/seed-qa.ts) holds only the "member" role
  // on the premium tenant. Premium rather than the free fixture tenant: the
  // free tenant's `api` rate-limit budget is already spent by the suite.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const login = await axios.post(`${baseUrl}/api/v1/auth/login`, {
    email: "member@qa-premium.test",
    password: bru.getEnvVar("qaPassword"),
  });
  const token = login.data.data.accessToken;
  bru.setVar("memberFormsToken", token);
  const auth = { headers: { Authorization: `Bearer ${token}` } };

  // AC4 — the meter an internal form reserves at creation, read before.
  const meter = await axios.get(`${baseUrl}/api/v1/meters/internal_forms`, auth);
  bru.setVar("memberCreateInternalFormsBefore", meter.data.data.used);
  const forms = await axios.get(`${baseUrl}/api/v1/forms?limit=100`, auth);
  bru.setVar("memberCreateFormCountBefore", forms.data.data.length);
}

assert {
  res.status: eq 403
  res.body.error.code: eq FORBIDDEN
  res.body.error.message: eq "Only an owner or admin can change forms"
  res.body.error.requestId: isDefined
  res.body.data: isUndefined
}

script:post-response {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const auth = { headers: { Authorization: `Bearer ${bru.getVar("memberFormsToken")}` } };

  const meter = await axios.get(`${baseUrl}/api/v1/meters/internal_forms`, auth);
  bru.setVar("memberCreateInternalFormsAfter", meter.data.data.used);
  const forms = await axios.get(`${baseUrl}/api/v1/forms?limit=100`, auth);
  bru.setVar("memberCreateFormCountAfter", forms.data.data.length);
  bru.setVar(
    "memberCreateSlugExists",
    forms.data.data.some((form) => form.slug === "qa-member-authz-create"),
  );
}

tests {
  test("AC4 — the refused create reserved no internal_forms quota", function () {
    expect(String(bru.getVar("memberCreateInternalFormsAfter"))).to.equal(
      String(bru.getVar("memberCreateInternalFormsBefore")),
    );
  });

  test("AC1 — no form was created", function () {
    expect(String(bru.getVar("memberCreateSlugExists"))).to.equal("false");
    expect(String(bru.getVar("memberCreateFormCountAfter"))).to.equal(
      String(bru.getVar("memberCreateFormCountBefore")),
    );
  });
}

docs {
  GRAFT-31 AC1 (create) and AC4. The body is a valid internal form against
  the premium tenant's customers entity (000000000000000000000016), so the
  only thing that can refuse it is the role check in
  src/server/services/forms.ts's `assertCanWriteForms`, which runs before the
  entity is read or `internal_forms` is reserved.
}
