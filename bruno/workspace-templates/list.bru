meta {
  name: The template gallery lists the ten business templates
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspace-templates
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{templatesAccessToken}}
}

script:pre-request {
  // The premium tenant's owner, not `loginAccessToken`: the free fixture
  // tenant's `api` rate-limit budget (60/min) is already spent in full by the
  // folders before this one, so every request here would be answered 429.
  // Same reasoning and same fix as bruno/setup/run-start.bru. Minted once and
  // reused by the rest of this folder.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const login = await axios.post(`${baseUrl}/api/v1/auth/login`, {
    email: "owner@qa-premium.test",
    password: bru.getEnvVar("qaPassword"),
  });
  bru.setVar("templatesAccessToken", login.data.data.accessToken);
}

assert {
  res.status: eq 200
  res.body.data.length: eq 10
  res.body.data[0].id: eq hotel
  res.body.data[0].name: eq Graft Hotel
  res.body.data[0].entities: isUndefined
}
