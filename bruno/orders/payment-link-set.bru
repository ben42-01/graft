meta {
  name: A Stripe payment link is attached to an order for the customer to pay through
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/api/v1/orders/{{draftEditOrderId}}/payment-link
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{invoiceAccessToken}}
}

body:json {
  {
    "url": "https://buy.stripe.com/test_qa_order?prefilled_email=ada%40example.test"
  }
}

assert {
  res.status: eq 200
  res.body.data.paymentLink.url: eq https://buy.stripe.com/test_qa_order?prefilled_email=ada%40example.test
}

tests {
  test("the link sent to the customer carries the order id, and keeps the tenant's own query", function () {
    // Bruno's sandbox has no `URL` global, so the query is read by hand.
    const data = res.getBody().data;
    const [origin, query] = data.paymentLink.payUrl.split("?");
    const params = {};
    for (const pair of query.split("&")) {
      const [key, value] = pair.split("=");
      params[key] = decodeURIComponent(value);
    }
    expect(origin).to.equal("https://buy.stripe.com/test_qa_order");
    expect(params.client_reference_id).to.equal(data.id);
    expect(params.prefilled_email).to.equal("ada@example.test");
  });
}
