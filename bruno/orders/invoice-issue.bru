meta {
  name: An invoice snapshots the order and takes the next number
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/invoices
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{invoiceAccessToken}}
}

body:json {
  {
    "orderId": "{{invoiceOrderId}}",
    "kind": "deposit"
  }
}

script:pre-request {
  // Invoicing is Premium (docs/TIERS.md §2.4), so the four invoice files run
  // as the *premium* tenant's owner — `loginAccessToken` is the Free tenant,
  // which is refused (see invoice-free-refused.bru). The order is built here:
  // the same EUR 620 order with a 30% deposit that create.bru drafts, paid to
  // its deposit so it is confirmed, which is what ledger.bru then reads.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const login = await axios.post(`${baseUrl}/api/v1/auth/login`, {
    email: "owner@qa-premium.test",
    password: bru.getEnvVar("qaPassword"),
  });
  const token = login.data.data.accessToken;
  bru.setVar("invoiceAccessToken", token);
  const auth = { headers: { Authorization: `Bearer ${token}` } };

  const order = await axios.post(
    `${baseUrl}/api/v1/orders`,
    {
      currency: "EUR",
      lineItems: [
        {
          kind: "resource",
          description: "24ft Pontoon Boat — 4 hours",
          quantity: 1,
          unitAmountMinor: 60000,
        },
        { kind: "addon", description: "Life jackets", quantity: 4, unitAmountMinor: 500 },
      ],
      deposit: { percent: 30 },
    },
    auth,
  );
  const orderId = order.data.data.id;
  await axios.post(
    `${baseUrl}/api/v1/orders/${orderId}/transitions`,
    { status: "pending_payment" },
    auth,
  );
  await axios.post(`${baseUrl}/api/v1/orders/${orderId}/payments`, { amountMinor: 18600 }, auth);
  bru.setVar("invoiceOrderId", orderId);
}

assert {
  res.status: eq 201
  res.body.data.status: eq open
  res.body.data.kind: eq deposit
  res.body.data.amountDueMinor: eq 18600
  res.body.error: isUndefined
}

script:post-response {
  bru.setVar("issuedInvoiceId", res.body.data.id);
}

tests {
  const invoice = res.getBody().data;

  test("the number is year-scoped and zero-padded", function () {
    expect(invoice.number).to.match(/^INV-\d{4}-\d{4,}$/);
  });

  test("the line items are copied, not referenced", function () {
    // A snapshot is the whole point of the document: what the customer was
    // asked to pay, on the day they were asked.
    expect(invoice.lineItems).to.have.lengthOf(2);
    expect(invoice.orderTotalMinor).to.equal(62000);
  });

  test("a deposit invoice asks for the deposit, not the total", function () {
    expect(invoice.amountDueMinor).to.equal(18600);
    expect(invoice.amountDueMinor).to.be.below(invoice.orderTotalMinor);
  });
}
