meta {
  name: A rotated refresh token is dead
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: none
}

headers {
  Cookie: graft_refresh={{qaRefreshRotate}}
}

assert {
  res.status: eq 401
  res.body.error.code: eq UNAUTHORIZED
  res.body.error.requestId: isDefined
  res.body.data: isUndefined
}

docs {
  AC2, second half. refresh.bru (seq 2) presented this exact token; from that
  moment it is invalid. Depends on seq 2 having run — the fixture is consumed
  there on purpose, because "single use" is only observable as a sequence.
}
