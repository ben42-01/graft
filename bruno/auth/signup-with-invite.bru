meta {
  name: Signup through an invite creates no workspace; a bad token creates nothing
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "joined-by-invite@qa-signup.test",
    "password": "{{qaPassword}}",
    "inviteToken": "{{signupInviteToken}}"
  }
}

script:pre-request {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const login = async (email) =>
    (await axios.post(`${baseUrl}/api/v1/auth/login`, {
      email,
      password: bru.getEnvVar("qaPassword"),
    })).data.data.accessToken;
  const owner = await login("owner@qa-premium.test");
  const made = await axios.post(
    `${baseUrl}/api/v1/team/invites`,
    { role: "admin" },
    { headers: { Authorization: `Bearer ${owner}` } },
  );
  bru.setVar("signupInviteToken", made.data.data.url.split("/invite/")[1]);
  bru.setVar("signupInviteId", made.data.data.invite.id);
  bru.setVar("signupInviteOwner", owner);
  const admin = await login("platform-admin@qa.test");
  bru.setVar("signupInviteAdmin", admin);
  const tenants = await axios.get(`${baseUrl}/api/v1/admin/tenants?limit=100`, {
    headers: { Authorization: `Bearer ${admin}` },
  });
  bru.setVar(
    "signupTenantsBefore",
    JSON.stringify({ n: tenants.data.data.length, more: tenants.data.meta.hasMore }),
  );
}

assert {
  res.status: eq 201
  res.body.data.tenantId: eq "000000000000000000000002"
  res.body.error: isUndefined
}

script:post-response {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const admin = { headers: { Authorization: `Bearer ${bru.getVar("signupInviteAdmin")}` } };
  const tenants = await axios.get(`${baseUrl}/api/v1/admin/tenants?limit=100`, admin);
  const users = await axios.get(
    `${baseUrl}/api/v1/admin/users?q=joined-by-invite@qa-signup`,
    admin,
  );
  const badBody = {
    email: "bad-invite@qa-signup.test",
    password: bru.getEnvVar("qaPassword"),
    inviteToken: "u".repeat(43),
  };
  const bad = await axios.post(`${baseUrl}/api/v1/auth/signup`, badBody, {
    validateStatus: () => true,
  });
  const badUsers = await axios.get(`${baseUrl}/api/v1/admin/users?q=bad-invite@qa-signup`, admin);
  const tenantsAfterBad = await axios.get(`${baseUrl}/api/v1/admin/tenants?limit=100`, admin);
  const team = await axios.get(`${baseUrl}/api/v1/team`, {
    headers: { Authorization: `Bearer ${bru.getVar("signupInviteOwner")}` },
  });
  bru.setVar(
    "signupInviteAfter",
    JSON.stringify({
      tenants: tenants.data.data.length,
      tenantsAfterBad: tenantsAfterBad.data.data.length,
      memberships: users.data.data[0].memberships.map((m) => `${m.tenantId} ${m.roles}`),
      badStatus: bad.status,
      badCode: bad.data?.error?.code,
      badFields: Object.keys(bad.data?.error?.details?.fields ?? {}),
      badUsers: badUsers.data.data.length,
      pending: team.data.data.invites.map((i) => i.id),
    }),
  );
}

tests {
  const before = JSON.parse(bru.getVar("signupTenantsBefore"));
  const after = JSON.parse(bru.getVar("signupInviteAfter"));

  test("AC6 — the only membership is the invited one", function () {
    expect(after.memberships).to.eql(["000000000000000000000002 admin"]);
  });

  test("AC6 — no tenant was created, by the valid signup or the invalid one", function () {
    expect(before.more).to.equal(false);
    expect(after.tenants).to.equal(before.n);
    expect(after.tenantsAfterBad).to.equal(before.n);
  });

  test("AC6 — the invite is spent", function () {
    expect(after.pending).to.not.include(bru.getVar("signupInviteId"));
  });

  test("AC6 — an invalid token is 400 VALIDATION_FAILED on inviteToken, and nothing is created", function () {
    expect(after.badStatus).to.equal(400);
    expect(after.badCode).to.equal("VALIDATION_FAILED");
    expect(after.badFields).to.eql(["inviteToken"]);
    expect(after.badUsers).to.equal(0);
  });
}

docs {
  AC6, both paths. Single-shot against a freshly seeded QA stack, like
  signup.bru. Tenants are counted through the platform-admin console.
}
