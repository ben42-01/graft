meta {
  name: Cross-tenant refresh is refused
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: none
}

headers {
  Cookie: graft_refresh=000000000000000000000001.{{qaRefreshPremiumSecret}}
}

assert {
  res.status: eq 401
  res.body.error.code: eq UNAUTHORIZED
  res.body.data: isUndefined
}

docs {
  The premium tenant's live refresh secret, presented under the free tenant's id.
  The stored token is looked up scoped to the tenant it names, so a caller who
  learns a secret still cannot spend it against another tenant — and cannot mint
  an access token carrying a `tid` the token was not issued for (AC5).
}
