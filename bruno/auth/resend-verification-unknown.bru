meta {
  name: Asking for a verification link for an unknown address looks exactly the same
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/auth/resend-verification
  body: json
  auth: none
}

body:json {
  {
    "email": "nobody-at-all@qa.test"
  }
}

assert {
  res.status: eq 204
  res.body: isEmpty
}

docs {
  Same status and same empty body as resend-verification.bru, so the endpoint
  cannot tell anyone which addresses have accounts.
}
