meta {
  name: The person approves
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/device/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{cliApproverToken}}
}

body:json {
  { "userCode": "{{cliUserCode}}", "decision": "approve" }
}

assert {
  res.status: eq 200
  res.body.data.status: eq approved
}
