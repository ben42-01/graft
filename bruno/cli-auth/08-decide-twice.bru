meta {
  name: A request is decided only once
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/device/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{cliApproverToken}}
}

body:json {
  { "userCode": "{{cliUserCode}}", "decision": "deny" }
}

assert {
  res.status: eq 404
  res.body.error.code: eq NOT_FOUND
}
