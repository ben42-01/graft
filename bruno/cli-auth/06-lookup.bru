meta {
  name: The approval page sees which client is asking
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/device/lookup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{cliApproverToken}}
}

script:pre-request {
  // As a person would type it: lower case, a space instead of the dash.
  req.setBody({ userCode: bru.getVar("cliUserCode").toLowerCase().replace("-", " ") });
}

assert {
  res.status: eq 200
  res.body.data.client.name: eq graft
  res.body.data.client.hostname: eq qa-runner
  res.body.data.client.platform: eq linux-x64
}

tests {
  test("the code comes back normalised", function () {
    expect(res.getBody().data.userCode).to.equal(bru.getVar("cliUserCode"));
  });
}
