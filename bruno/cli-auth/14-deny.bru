meta {
  name: The person denies it
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/auth/device/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{cliApproverToken}}
}

body:json {
  { "userCode": "{{cliDeniedUserCode}}", "decision": "deny" }
}

assert {
  res.status: eq 200
  res.body.data.status: eq denied
}
