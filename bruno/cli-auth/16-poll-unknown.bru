meta {
  name: An unknown device code is UNAUTHORIZED
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/auth/device/token
  body: json
  auth: none
}

body:json {
  { "deviceCode": "not-a-real-device-code-0000000000000000000" }
}

assert {
  res.status: eq 401
  res.body.error.code: eq UNAUTHORIZED
}
