meta {
  name: CLI poll before approval is pending
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/device/token
  body: json
  auth: none
}

body:json {
  { "deviceCode": "{{cliDeviceCode}}" }
}

assert {
  res.status: eq 200
  res.body.data.status: eq pending
  res.body.data.interval: eq 5
}

tests {
  test("never cached", function () {
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });
}
