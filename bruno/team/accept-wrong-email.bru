meta {
  name: An invite bound to another email is refused and stays pending
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/team/invites/accept
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{teamWrongJwt}}
}

body:json {
  {
    "token": "{{teamWrongToken}}"
  }
}

script:pre-request {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const login = async (email) =>
    (await axios.post(`${baseUrl}/api/v1/auth/login`, {
      email,
      password: bru.getEnvVar("qaPassword"),
    })).data.data.accessToken;
  const owner = await login("owner@qa-premium.test");
  const made = await axios.post(
    `${baseUrl}/api/v1/team/invites`,
    { role: "member", email: "someone.else@qa-premium.test" },
    { headers: { Authorization: `Bearer ${owner}` } },
  );
  bru.setVar("teamWrongToken", made.data.data.url.split("/invite/")[1]);
  bru.setVar("teamWrongInviteId", made.data.data.invite.id);
  bru.setVar("teamWrongOwner", owner);
  bru.setVar("teamWrongJwt", await login("invitee-wrong@qa-platform.test"));
}

assert {
  res.status: eq 403
  res.body.error.code: eq FORBIDDEN
  res.body.data: isUndefined
}

script:post-response {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const team = await axios.get(`${baseUrl}/api/v1/team`, {
    headers: { Authorization: `Bearer ${bru.getVar("teamWrongOwner")}` },
  });
  bru.setVar(
    "teamWrongAfter",
    JSON.stringify({
      pending: team.data.data.invites.map((i) => i.id),
      members: team.data.data.members.map((m) => m.email),
    }),
  );
}

tests {
  const after = JSON.parse(bru.getVar("teamWrongAfter"));

  test("AC3 — the invite is still pending", function () {
    expect(after.pending).to.include(bru.getVar("teamWrongInviteId"));
  });

  test("AC3 — the refused user was not added", function () {
    expect(after.members).to.not.include("invitee-wrong@qa-platform.test");
  });
}
