meta {
  name: A step's outcome merges into the run without clearing earlier answers
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/setup
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{loginAccessToken}}
}

body:json {
  {
    "thingLabel": "Kilns",
    "intent": "bookings",
    "step": "shape"
  }
}

assert {
  res.status: eq 200
  res.body.data.thingLabel: eq Kilns
  res.body.data.intent: eq bookings
  res.body.data.step: eq shape
  res.body.error: isUndefined
}

tests {
  test("patches the run that is already open rather than starting another", function () {
    expect(res.getBody().data.id).to.equal(bru.getVar("setupRunId"));
  });
}
