meta {
  name: Creating an entity compiles it at schemaVersion 1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/entities
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{loginAccessToken}}
}

body:json {
  {
    "key": "products",
    "name": "Products",
    "fields": [
      { "key": "title", "label": "Title", "type": "text", "required": true },
      { "key": "price", "label": "Price", "type": "number", "required": true, "min": 0 }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.data.key: eq products
  res.body.data.schemaVersion: eq 1
  res.body.error: isUndefined
}

script:post-response {
  // Carried into update.bru and list.bru — created against the free tenant
  // (loginAccessToken, GRAFT-03.2 fixtures).
  bru.setVar("createdEntityId", res.body.data.id);
}

tests {
  const entity = res.getBody().data;

  test("AC1 — reads back with the fields it was created with", function () {
    expect(entity.fields).to.have.lengthOf(2);
    expect(entity.fields.map((f) => f.key).sort()).to.eql(["price", "title"]);
  });

  test("AC2 — the id is a real Mongo ObjectId hex", function () {
    expect(entity.id).to.match(/^[0-9a-f]{24}$/);
  });
}

docs {
  AC1, AC2. Requires bruno/auth/login.bru to have run first (loginAccessToken),
  which the alphabetical folder order (auth before entities) guarantees under
  `bru run -r`.
}
