meta {
  name: Another tenant's customer is not found
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/customers/000000000000000000000029
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{bmsAccessToken}}
}

assert {
  res.status: eq 404
  res.body.error.code: eq NOT_FOUND
  res.body.error.requestId: isDefined
  res.body.data: isUndefined
}

docs {
  000000000000000000000029 is a record on the *free* tenant
  (recordFreeFirst, scripts/seed-qa.ts). Read as the premium tenant it is
  indistinguishable from an id that never existed — and so is one of the
  caller's own records that no order points at.
}
