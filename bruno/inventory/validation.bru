meta {
  name: A range that ends before it starts is refused
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/inventory/pools/000000000000000000000065/holds
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{loginAccessToken}}
}

body:json {
  {
    "startAt": "2030-06-20T14:00:00.000Z",
    "endAt": "2030-06-20T10:00:00.000Z",
    "quantity": 1
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_FAILED
  res.body.data: isUndefined
}

tests {
  test("the range is validated before any pool or allocation is touched", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
