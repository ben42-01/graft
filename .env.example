# Graft — environment template (docs/WORKFLOW.md §4.3)
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL. It is the shape only.
# `npm run setup` generates .env.dev and .env.qa from this template with
# per-machine random passwords. Those generated files are gitignored and must
# never be committed. Production values live in the platform secret manager.

# Which environment this file describes: dev | qa | production
APP_ENV=dev
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# The app connects as a least-privilege user with readWrite on its own DB only.
# It never knows the root credentials, in any environment.
MONGO_DB=graft_dev
MONGO_PORT=27017
MONGO_ROOT_USER=graft_root
MONGO_ROOT_PASSWORD=__generated__
MONGO_APP_USER=graft_app
MONGO_APP_PASSWORD=__generated__
MONGODB_URI=mongodb://graft_app:__generated__@localhost:27017/graft_dev?authSource=graft_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# ── Auth (docs/BACKEND.md §3.1) ───────────────────────────────────────────────
# RS256/EdDSA keypair, generated into .keys/ by `npm run setup`. Gitignored.
JWT_PRIVATE_KEY_PATH=.keys/dev-jwt-private.pem
JWT_PUBLIC_KEY_PATH=.keys/dev-jwt-public.pem

# ── Billing (docs/TIERS.md §3-4, GRAFT-15) ────────────────────────────────────
# Test-mode Stripe keys locally; live keys only ever live in the platform
# secret manager. STRIPE_WEBHOOK_SECRET only has to match what signs the
# events this app verifies — `npm run setup` generates a local one; it does
# not need to come from a real Stripe account for dev/QA use.
STRIPE_SECRET_KEY=sk_test___generated__
STRIPE_WEBHOOK_SECRET=whsec___generated__
STRIPE_PRICE_PREMIUM_MONTHLY=price___generated__
STRIPE_PRICE_PREMIUM_ANNUAL=price___generated__
