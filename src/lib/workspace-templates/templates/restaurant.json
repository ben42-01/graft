{
  "id": "restaurant",
  "name": "Graft Restaurant",
  "tagline": "Restaurants, cafés, bars and bistros",
  "description": "Your tables by size, a public reservation page that stops you taking more bookings than you have tables, and an optional catering enquiry form.",
  "icon": "🍽️",
  "industry": "Food & drink",
  "highlights": [
    "Tables by size with how many of each",
    "Reservations with a set sitting length",
    "Full sittings refused automatically",
    "Optional catering enquiries"
  ],
  "nouns": [
    {
      "id": "table",
      "singular": "Table",
      "plural": "Tables",
      "question": "What do guests reserve? (Tables, Booths, Seats…)"
    }
  ],
  "toggles": [
    {
      "id": "bookable",
      "kind": "boolean",
      "label": "Take reservations online",
      "help": "On: each reservation holds a table for the sitting. Off: guests send a request and you call back.",
      "default": true
    },
    {
      "id": "sitting_length",
      "kind": "choice",
      "label": "How long is a sitting?",
      "options": [
        { "value": "min_60", "label": "1 hour" },
        { "value": "min_90", "label": "1½ hours" },
        { "value": "min_120", "label": "2 hours" }
      ],
      "default": "min_90"
    }
  ],
  "modules": [
    {
      "id": "catering",
      "name": "Catering",
      "description": "A public catering enquiry form for events and a list to follow them up."
    }
  ],
  "policy": {
    "title": "Booking policy",
    "body": "We hold tables for 15 minutes after the booking time. Please let us know about allergies in advance. Groups of 8 or more may be asked for a deposit."
  },
  "entities": [
    {
      "ref": "tables",
      "key": "tables",
      "name": "Tables",
      "noun": "table",
      "fields": [
        { "key": "name", "label": "{Table}", "type": "text", "required": true },
        { "key": "seats", "label": "Seats", "type": "number", "required": true },
        { "key": "description", "label": "Description", "type": "text", "optional": true },
        { "key": "photo", "label": "Photo", "type": "image", "optional": true },
        {
          "key": "booking_fee",
          "label": "Booking fee (0 for none)",
          "type": "number",
          "required": true
        }
      ]
    },
    {
      "ref": "reservations",
      "key": "reservations",
      "name": "Reservations",
      "fields": [
        { "key": "name", "label": "Your name", "type": "text", "required": true },
        { "key": "email", "label": "Email", "type": "email", "required": true },
        { "key": "phone", "label": "Phone", "type": "phone", "required": true },
        { "key": "reservation_at", "label": "Date and time", "type": "date", "required": true },
        {
          "key": "party_size",
          "label": "Number of people",
          "type": "number",
          "required": true
        },
        { "key": "selected_item", "label": "{Table}", "type": "text" },
        {
          "key": "occasion",
          "label": "Occasion",
          "type": "select",
          "options": ["None", "Birthday", "Anniversary", "Business", "Other"],
          "optional": true
        },
        {
          "key": "dietary",
          "label": "Allergies or dietary needs",
          "type": "text",
          "optional": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": ["Booked", "Seated", "No-show", "Cancelled"]
        }
      ]
    },
    {
      "ref": "catering",
      "key": "catering_enquiries",
      "name": "Catering enquiries",
      "module": "catering",
      "fields": [
        { "key": "name", "label": "Your name", "type": "text", "required": true },
        { "key": "email", "label": "Email", "type": "email", "required": true },
        { "key": "phone", "label": "Phone", "type": "phone" },
        { "key": "event_date", "label": "Event date", "type": "date", "required": true },
        { "key": "guests", "label": "Number of guests", "type": "number", "required": true },
        {
          "key": "style",
          "label": "Style",
          "type": "select",
          "options": ["Buffet", "Canapés", "Sit-down", "Drop-off platters"]
        },
        { "key": "budget", "label": "Budget", "type": "number", "optional": true },
        {
          "key": "details",
          "label": "Tell us about the event",
          "type": "text",
          "optional": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": ["New", "Quoted", "Booked", "Lost"]
        }
      ]
    }
  ],
  "samples": [
    {
      "entityRef": "tables",
      "pool": {
        "strategy": "pooled_quantity",
        "when": [{ "toggle": "bookable", "equals": true }]
      },
      "records": [
        { "data": { "name": "{Table} for 2", "seats": 2, "booking_fee": 0 }, "quantity": 8 },
        { "data": { "name": "{Table} for 4", "seats": 4, "booking_fee": 0 }, "quantity": 6 },
        {
          "data": {
            "name": "Large {table} (6–10)",
            "seats": 10,
            "description": "For groups — we may ask for a deposit.",
            "booking_fee": 0
          },
          "quantity": 2
        }
      ]
    }
  ],
  "forms": [
    {
      "ref": "reservation",
      "entityRef": "reservations",
      "name": "Reserve a {table}",
      "slug": "reserve-a-{table}",
      "visibility": "public",
      "fields": [
        "name",
        "email",
        "phone",
        "reservation_at",
        "party_size",
        "selected_item",
        "occasion",
        "dietary"
      ],
      "catalogue": {
        "entityRef": "tables",
        "fields": ["name", "seats", "description"],
        "imageField": "photo",
        "selectionKey": "selected_item"
      },
      "booking": {
        "when": [{ "toggle": "bookable", "equals": true }],
        "startKey": "reservation_at",
        "durationMinutes": { "toggle": "sitting_length" },
        "rateBasis": "flat",
        "rateKey": "booking_fee",
        "labelKey": "name"
      },
      "terms": true
    },
    {
      "ref": "catering_enquiry",
      "entityRef": "catering",
      "module": "catering",
      "name": "Catering enquiry",
      "slug": "catering",
      "visibility": "public",
      "fields": [
        "name",
        "email",
        "phone",
        "event_date",
        "guests",
        "style",
        "budget",
        "details"
      ],
      "payment": true
    }
  ]
}
