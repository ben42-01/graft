{
  "id": "tours",
  "name": "Graft Tours",
  "tagline": "Tours, boat trips, escape rooms, workshops and experiences",
  "description": "Your experiences with prices per person and how many places each departure has, a public booking page where guests choose an experience, a time and how many are coming, and departures that never sell more places than you have.",
  "icon": "🧭",
  "industry": "Tourism & leisure",
  "highlights": [
    "Experiences priced per person",
    "Guests pick a departure and group size",
    "Full departures refused automatically",
    "Optional deposit, payment and booking terms",
    "Optional private-group enquiries and guide roster"
  ],
  "nouns": [
    {
      "id": "experience",
      "singular": "Experience",
      "plural": "Experiences",
      "question": "What do guests book? (Experiences, Tours, Trips, Rooms…)"
    }
  ],
  "toggles": [
    {
      "id": "bookable",
      "kind": "boolean",
      "label": "Take bookings online",
      "help": "On: each booking takes places on a departure and full ones are refused. Off: guests send a request and you confirm.",
      "default": true
    },
    {
      "id": "duration",
      "kind": "choice",
      "label": "How long does an experience last?",
      "options": [
        { "value": "min_60", "label": "1 hour" },
        { "value": "min_120", "label": "2 hours" },
        { "value": "min_180", "label": "3 hours" },
        { "value": "min_480", "label": "A full day" }
      ],
      "default": "min_120"
    }
  ],
  "modules": [
    {
      "id": "private_groups",
      "name": "Private groups",
      "description": "A public enquiry form for private tours, schools and corporate groups, and a list to follow them up."
    },
    {
      "id": "guides",
      "name": "Guides",
      "description": "Your guides and hosts with the languages they speak."
    }
  ],
  "policy": {
    "title": "Booking terms",
    "body": "Please arrive 15 minutes before your start time. Cancel up to 48 hours before for a full refund. If we cancel for weather or safety, you can rebook or get your money back."
  },
  "entities": [
    {
      "ref": "experiences",
      "key": "experiences",
      "name": "Experiences",
      "noun": "experience",
      "fields": [
        { "key": "name", "label": "{Experience}", "type": "text", "required": true },
        { "key": "description", "label": "Description", "type": "text", "optional": true },
        { "key": "photo", "label": "Photo", "type": "image", "optional": true },
        { "key": "meeting_point", "label": "Meeting point", "type": "text", "optional": true },
        { "key": "min_age", "label": "Minimum age", "type": "number", "optional": true },
        { "key": "price", "label": "Price per person", "type": "number", "required": true }
      ]
    },
    {
      "ref": "bookings",
      "key": "experience_bookings",
      "name": "Bookings",
      "fields": [
        { "key": "name", "label": "Your name", "type": "text", "required": true },
        { "key": "email", "label": "Email", "type": "email", "required": true },
        { "key": "phone", "label": "Phone", "type": "phone", "required": true },
        { "key": "starts_at", "label": "Date and time", "type": "date", "required": true },
        { "key": "people", "label": "Number of people", "type": "number", "required": true },
        { "key": "selected_item", "label": "{Experience}", "type": "text" },
        {
          "key": "language",
          "label": "Preferred language",
          "type": "select",
          "options": ["English", "German", "French", "Spanish", "Italian", "Other"],
          "optional": true
        },
        {
          "key": "notes",
          "label": "Anything we should know?",
          "type": "text",
          "optional": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": ["Booked", "Paid", "Checked in", "No-show", "Cancelled"]
        }
      ]
    },
    {
      "ref": "group_enquiries",
      "key": "group_enquiries",
      "name": "Group enquiries",
      "module": "private_groups",
      "fields": [
        { "key": "name", "label": "Your name", "type": "text", "required": true },
        { "key": "email", "label": "Email", "type": "email", "required": true },
        { "key": "phone", "label": "Phone", "type": "phone" },
        {
          "key": "organisation",
          "label": "School or company",
          "type": "text",
          "optional": true
        },
        {
          "key": "preferred_date",
          "label": "Preferred date",
          "type": "date",
          "required": true
        },
        { "key": "group_size", "label": "Group size", "type": "number", "required": true },
        {
          "key": "details",
          "label": "What are you looking for?",
          "type": "text",
          "optional": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": ["New", "Quoted", "Booked", "Lost"]
        }
      ]
    },
    {
      "ref": "guides",
      "key": "guides",
      "name": "Guides",
      "module": "guides",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "email", "label": "Email", "type": "email" },
        { "key": "phone", "label": "Phone", "type": "phone" },
        { "key": "languages", "label": "Languages", "type": "text", "optional": true },
        { "key": "notes", "label": "Notes", "type": "text", "optional": true }
      ]
    }
  ],
  "samples": [
    {
      "entityRef": "experiences",
      "pool": {
        "strategy": "pooled_quantity",
        "when": [{ "toggle": "bookable", "equals": true }]
      },
      "records": [
        {
          "data": {
            "name": "Old town walking tour",
            "description": "Hidden courtyards, local stories and the best viewpoint in town.",
            "meeting_point": "Fountain on the main square",
            "price": 25
          },
          "quantity": 15
        },
        {
          "data": {
            "name": "Sunset boat trip",
            "description": "Ninety minutes on the water with a drink on board.",
            "meeting_point": "Harbour, pier 3",
            "min_age": 6,
            "price": 45
          },
          "quantity": 12
        },
        {
          "data": {
            "name": "Street food tasting",
            "description": "Six stops, six local specialities.",
            "min_age": 12,
            "price": 59
          },
          "quantity": 10
        }
      ]
    }
  ],
  "forms": [
    {
      "ref": "booking",
      "entityRef": "bookings",
      "name": "Book an {experience}",
      "slug": "book",
      "visibility": "public",
      "fields": [
        "name",
        "email",
        "phone",
        "selected_item",
        "starts_at",
        "people",
        "language",
        "notes"
      ],
      "catalogue": {
        "entityRef": "experiences",
        "fields": ["name", "description", "meeting_point", "min_age", "price"],
        "imageField": "photo",
        "selectionKey": "selected_item"
      },
      "booking": {
        "when": [{ "toggle": "bookable", "equals": true }],
        "startKey": "starts_at",
        "durationMinutes": { "toggle": "duration" },
        "quantityKey": "people",
        "rateBasis": "flat",
        "rateKey": "price",
        "labelKey": "name",
        "deposit": true
      },
      "payment": true,
      "terms": true
    },
    {
      "ref": "group_enquiry",
      "entityRef": "group_enquiries",
      "module": "private_groups",
      "name": "Private group enquiry",
      "slug": "private-groups",
      "visibility": "public",
      "fields": [
        "name",
        "email",
        "phone",
        "organisation",
        "preferred_date",
        "group_size",
        "details"
      ]
    }
  ]
}
